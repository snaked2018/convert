{% doc %}
  @param lookbooks {string} JSON array — productHandles only
  @param section_id {string}
  @param columns_desktop {number}
  @param columns_mobile {string}
  @param image_ratio {string}
  @param show_secondary_image {boolean}
  @param show_vendor {boolean}
{% enddoc %}

{%- liquid
  assign country_code = localization.country.iso_code
-%}

<div
  id="lookbook-{{ section_id }}"
  class="lookbook-root"
  data-lookbook-config='{
    "lookbooks": {{ lookbooks }},
    "country": {{ country_code | json }},
    "sectionId": {{ section_id | json }},
    "columnsDesktop": {{ columns_desktop | default: 4 }},
    "columnsMobile": {{ columns_mobile | default: "2" | json }},
    "imageRatio": {{ image_ratio | default: "portrait" | json }},
    "showSecondaryImage": {{ show_secondary_image | default: true }},
    "showVendor": {{ show_vendor | default: false }}
  }'
></div>
