{% doc %}
  @param lookbooks {string} JSON array string
  @param section_id {string}
{% enddoc %}

{%- liquid
  assign country_code = localization.country.iso_code
  assign currency_code = cart.currency.iso_code
-%}

<div
  id="lookbook-{{ section_id }}"
  class="lookbook-root"
  data-lookbook-config='{
    "lookbooks": {{ lookbooks }},
    "country": {{ country_code | json }},
    "currency": {{ currency_code | json }}
  }'
></div>