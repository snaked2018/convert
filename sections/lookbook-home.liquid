{%- liquid
  assign lookbook_item = section.settings.lookbook
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- if lookbook_item != blank -%}
  {%- capture description_html -%}
    {{ lookbook_item.description | metafield_tag }}
  {%- endcapture -%}

  {%- capture lookbooks_json -%}
  [{
    "title": {{ lookbook_item.title.value | json }},
    "descriptionHtml": {{ description_html | strip | json }},
    "productHandles": {{ lookbook_item.product_handles.value | json }}
  }]
  {%- endcapture -%}

  <div class="page-width section-{{ section.id }}-padding">
    {% render 'lookbook-mount',
      lookbooks: lookbooks_json,
      section_id: section.id
    %}
  </div>

{%- elsif request.design_mode -%}
  <div class="page-width section-{{ section.id }}-padding">
    <p>Select a lookbook in section settings.</p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Lookbook (Home)",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Lookbook",
      "info": "Select a lookbook to display on the home page."
    },
    {
      "type": "metaobject",
      "id": "lookbook",
      "label": "Lookbook",
      "metaobject_type": "lookbook"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Lookbook (Home)"
    }
  ]
}
{% endschema %}
