{%- liquid
  assign max_lookbooks = 2
  assign match_count = 0

  for lb in shop.metaobjects.lookbook.values
    if match_count >= max_lookbooks
      break
    endif

    assign handles = lb.product_handles.value
    if handles != blank and handles contains product.handle
      assign match_count = match_count | plus: 1
    endif
  endfor
-%}

{%- if match_count > 0 -%}
  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  <div class="page-width section-{{ section.id }}-padding">
    {%- if match_count > 1 -%}
      <div
        class="lookbook-carousel"
        id="LookbookCarousel-{{ section.id }}"
        data-lookbook-carousel
      >
        <div class="lookbook-carousel__tabs" role="tablist" aria-label="Lookbook selection">
          {%- assign tab_index = 0 -%}
          {%- assign tab_rendered = 0 -%}
          {%- for lb in shop.metaobjects.lookbook.values -%}
            {%- if tab_rendered >= max_lookbooks -%}
              {%- break -%}
            {%- endif -%}

            {%- assign handles = lb.product_handles.value -%}
            {%- if handles != blank and handles contains product.handle -%}
              <button
                type="button"
                class="lookbook-carousel__tab{% if tab_index == 0 %} lookbook-carousel__tab--active{% endif %}"
                role="tab"
                data-lookbook-tab="{{ tab_index }}"
                aria-selected="{% if tab_index == 0 %}true{% else %}false{% endif %}"
                aria-controls="LookbookPanel-{{ section.id }}-{{ tab_index }}"
              >
                {{ lb.title.value }}
              </button>
              {%- assign tab_index = tab_index | plus: 1 -%}
              {%- assign tab_rendered = tab_rendered | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- assign panel_index = 0 -%}
        {%- assign panel_rendered = 0 -%}
        {%- for lb in shop.metaobjects.lookbook.values -%}
          {%- if panel_rendered >= max_lookbooks -%}
            {%- break -%}
          {%- endif -%}

          {%- assign handles = lb.product_handles.value -%}
          {%- if handles != blank and handles contains product.handle -%}
            {%- liquid
              assign panel_hidden = false
              unless panel_index == 0
                assign panel_hidden = true
              endunless
            -%}
            <div id="LookbookPanel-{{ section.id }}-{{ panel_index }}">
              {% render 'lookbook-product-panel',
                lookbook: lb,
                section_id: section.id,
                panel_index: panel_index,
                panel_hidden: panel_hidden,
                columns_desktop: section.settings.columns_desktop,
                columns_mobile: section.settings.columns_mobile,
                image_ratio: section.settings.image_ratio,
                show_secondary_image: section.settings.show_secondary_image,
                show_vendor: section.settings.show_vendor
              %}
            </div>
            {%- assign panel_index = panel_index | plus: 1 -%}
            {%- assign panel_rendered = panel_rendered | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      {%- for lb in shop.metaobjects.lookbook.values -%}
        {%- assign handles = lb.product_handles.value -%}
        {%- if handles != blank and handles contains product.handle -%}
          {% render 'lookbook-product-panel',
            lookbook: lb,
            section_id: section.id,
            panel_index: 0,
            columns_desktop: section.settings.columns_desktop,
            columns_mobile: section.settings.columns_mobile,
            image_ratio: section.settings.image_ratio,
            show_secondary_image: section.settings.show_secondary_image,
            show_vendor: section.settings.show_vendor
          %}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Lookbook (Products)",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows lookbooks that include the current product. A maximum of two lookbooks are displayed."
    },
    {
      "type": "header",
      "content": "Product grid"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns on desktop",
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Square" }
      ],
      "default": "portrait"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Show second image on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Lookbook (Products)"
    }
  ]
}
{% endschema %}
