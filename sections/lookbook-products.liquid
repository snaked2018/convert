{%- liquid
  assign max_lookbooks = 2
  assign match_count = 0

  for lb in shop.metaobjects.lookbook.values
    if match_count >= max_lookbooks
      break
    endif

    assign handles = lb.product_handles.value
    if handles != blank and handles contains product.handle
      assign match_count = match_count | plus: 1
    endif
  endfor
-%}

{%- if match_count > 0 -%}
  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    {%- if section.settings.background_color != blank -%}
      .section-{{ section.id }}-wrapper {
        background: {{ section.settings.background_color }};
      }
    {%- endif -%}

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  <div class="section-{{ section.id }}-wrapper color-{{ section.settings.color_scheme }}{% if section.settings.background_color == blank %} gradient{% endif %}">
    <div class="page-width section-{{ section.id }}-padding">
      {%- if match_count > 1 -%}
        {{ 'section-image-banner.css' | asset_url | stylesheet_tag }}

        <div
          class="lookbook-carousel"
          id="LookbookCarousel-{{ section.id }}"
          data-lookbook-carousel
        >
          {% render 'lookbook-carousel-banner',
            section_id: section.id,
            product_handle: product.handle,
            banner_height: section.settings.banner_height,
            banner_content_position: section.settings.banner_content_position,
            banner_mobile_content_alignment: section.settings.banner_mobile_content_alignment,
            banner_desktop_content_alignment: section.settings.banner_desktop_content_alignment,
            banner_overlay_opacity: section.settings.banner_overlay_opacity,
            banner_color_scheme: section.settings.banner_color_scheme,
            banner_background_color: section.settings.banner_background_color,
            banner_content_background_image: section.settings.banner_content_background_image
          %}

        {%- assign panel_index = 0 -%}
        {%- assign panel_rendered = 0 -%}
        {%- for lb in shop.metaobjects.lookbook.values -%}
          {%- if panel_rendered >= max_lookbooks -%}
            {%- break -%}
          {%- endif -%}

          {%- assign handles = lb.product_handles.value -%}
          {%- if handles != blank and handles contains product.handle -%}
            {%- liquid
              assign panel_hidden = false
              unless panel_index == 0
                assign panel_hidden = true
              endunless
              assign mount_id = section.id | append: '-' | append: panel_index
            -%}
            {%- capture lookbooks_json -%}
            [{"productHandles": {{ lb.product_handles.value | json }}}]
            {%- endcapture -%}
            <div
              id="LookbookPanel-{{ section.id }}-{{ panel_index }}"
              class="lookbook-carousel__panel{% if panel_hidden == true %} lookbook-carousel__panel--hidden{% endif %}"
              data-lookbook-panel="{{ panel_index }}"
            >
              {% render 'lookbook-mount',
                lookbooks: lookbooks_json,
                section_id: mount_id,
                columns_desktop: section.settings.columns_desktop,
                columns_mobile: section.settings.columns_mobile,
                image_ratio: section.settings.image_ratio,
                show_secondary_image: section.settings.show_secondary_image,
                show_vendor: section.settings.show_vendor
              %}
            </div>
            {%- assign panel_index = panel_index | plus: 1 -%}
            {%- assign panel_rendered = panel_rendered | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      {%- for lb in shop.metaobjects.lookbook.values -%}
        {%- assign handles = lb.product_handles.value -%}
        {%- if handles != blank and handles contains product.handle -%}
          {% render 'lookbook-product-panel',
            lookbook: lb,
            section_id: section.id,
            panel_index: 0,
            panel_hidden: false,
            banner_height: section.settings.banner_height,
            banner_content_position: section.settings.banner_content_position,
            banner_mobile_content_alignment: section.settings.banner_mobile_content_alignment,
            banner_desktop_content_alignment: section.settings.banner_desktop_content_alignment,
            banner_overlay_opacity: section.settings.banner_overlay_opacity,
            banner_color_scheme: section.settings.banner_color_scheme,
            banner_background_color: section.settings.banner_background_color,
            banner_content_background_image: section.settings.banner_content_background_image,
            columns_desktop: section.settings.columns_desktop,
            columns_mobile: section.settings.columns_mobile,
            image_ratio: section.settings.image_ratio,
            show_secondary_image: section.settings.show_secondary_image,
            show_vendor: section.settings.show_vendor
          %}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Lookbook (Products)",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background color",
      "info": "Overrides the section background when set. Leave empty to use the color scheme only."
    },
    {
      "type": "paragraph",
      "content": "Shows lookbooks that include the current product. A maximum of two lookbooks are displayed. Banner image, title, and description come from each matching lookbook metaobject."
    },
    {
      "type": "header",
      "content": "Banner"
    },
    {
      "type": "select",
      "id": "banner_height",
      "label": "Banner height",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "banner_content_position",
      "label": "Content position",
      "options": [
        { "value": "top-left", "label": "Top left" },
        { "value": "top-center", "label": "Top center" },
        { "value": "top-right", "label": "Top right" },
        { "value": "middle-left", "label": "Middle left" },
        { "value": "middle-center", "label": "Middle center" },
        { "value": "middle-right", "label": "Middle right" },
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "bottom-center", "label": "Bottom center" },
        { "value": "bottom-right", "label": "Bottom right" }
      ],
      "default": "middle-center"
    },
    {
      "type": "select",
      "id": "banner_desktop_content_alignment",
      "label": "Desktop content alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "banner_mobile_content_alignment",
      "label": "Mobile content alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "banner_overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "%",
      "label": "Image overlay opacity",
      "default": 30
    },
    {
      "type": "select",
      "id": "banner_color_scheme",
      "options": [
        { "value": "accent-1", "label": "t:sections.all.colors.accent_1.label" },
        { "value": "accent-2", "label": "t:sections.all.colors.accent_2.label" },
        { "value": "background-1", "label": "t:sections.all.colors.background_1.label" },
        { "value": "background-2", "label": "t:sections.all.colors.background_2.label" },
        { "value": "inverse", "label": "t:sections.all.colors.inverse.label" }
      ],
      "default": "background-1",
      "label": "Banner box color scheme",
      "info": "t:sections.image-banner.settings.color_scheme.info"
    },
    {
      "type": "color",
      "id": "banner_background_color",
      "label": "Banner background color",
      "info": "Background behind the banner image. Useful as a fallback or letterbox color."
    },
    {
      "type": "image_picker",
      "id": "banner_content_background_image",
      "label": "Content background image",
      "info": "Optional background image for the banner content area behind the text box."
    },
    {
      "type": "header",
      "content": "Product grid"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns on desktop",
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Square" }
      ],
      "default": "portrait"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Show second image on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Lookbook (Products)"
    }
  ]
}
{% endschema %}
